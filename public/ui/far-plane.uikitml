<!--
  Far plane - file list / overview.
  Furthest in the depth stack.
-->
<style>
  .far-root {
    flex-direction: column;
    width: 280px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(24, 24, 28, 0.75);
    border-radius: 10px;
    gap: 4px;
  }

  .section-title {
    font-size: 11px;
    font-weight: 700;
    color: #71717a;
    margin-bottom: 4px;
  }

  .file-item {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 6px;
    font-size: 12px;
    color: #d4d4d8;
  }

  .file-item:hover {
    background-color: rgba(63, 63, 70, 0.6);
  }

  .file-item-active {
    background-color: rgba(59, 130, 246, 0.25);
    color: #93c5fd;
  }

  .file-icon {
    font-size: 11px;
    color: #52525b;
  }

  .stats {
    margin-top: 8px;
    padding-top: 8px;
    font-size: 11px;
    color: #71717a;
  }
</style>

<Panel class="far-root">
  <div class="section-title">Changed Files</div>
  <div class="file-item file-item-active" id="file-session">
    <div class="file-icon">TS</div>
    <div>src/auth/session.ts</div>
  </div>
  <div class="file-item" id="file-middleware">
    <div class="file-icon">TS</div>
    <div>src/middleware/auth.ts</div>
  </div>
  <div class="file-item" id="file-test">
    <div class="file-icon">TS</div>
    <div>tests/auth.test.ts</div>
  </div>
  <div class="stats" id="overview-stats">
    3 files · 2 hunks remaining
  </div>
</Panel>