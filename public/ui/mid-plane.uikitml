<!--
  Productivity area: REVIEW
  Mid plane - scannable diff for the active file.
-->
<style>
  .mid-root {
    flex-direction: column;
    width: 520px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(12, 12, 16, 0.94);
    border-radius: 10px;
    gap: 6px;
  }

  .zone-label {
    font-size: 10px;
    font-weight: 700;
    color: #60a5fa;
  }

  .file-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
  }

  .file-name {
    font-size: 13px;
    font-weight: 600;
    color: #e4e4e7;
    font-family: fira-code;
  }

  .hunk-count {
    font-size: 11px;
    color: #71717a;
  }

  .diff-summary {
    font-size: 11px;
    color: #a1a1aa;
    margin-bottom: 2px;
  }

  .diff-body {
    flex-direction: column;
    gap: 2px;
  }

  .line {
    flex-direction: row;
    font-family: fira-code;
    font-size: 12px;
    line-height: 18px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 3px;
  }

  .line-num {
    width: 28px;
    color: #52525b;
    text-align: right;
    margin-right: 8px;
  }

  .line-add {
    background-color: rgba(22, 101, 52, 0.35);
    color: #bbf7d0;
  }

  .line-del {
    background-color: rgba(127, 29, 29, 0.35);
    color: #fecaca;
  }

  .line-ctx {
    color: #a1a1aa;
  }

  .hunk-header {
    font-size: 11px;
    color: #60a5fa;
    margin-top: 4px;
    margin-bottom: 2px;
    font-weight: 600;
  }
</style>

<Panel class="mid-root">
  <div class="zone-label" id="zone-review">REVIEW</div>
  <div class="file-header">
    <div class="file-name" id="current-file">src/auth/session.ts</div>
    <div class="hunk-count" id="hunk-info">Hunk 1 of 2</div>
  </div>
  <div class="diff-summary" id="diff-summary">jwt.decode to jwt.verify + expiry check</div>
  <div class="diff-body" id="diff-body">
    <div class="hunk-header" id="hunk-header">@@ -42,7 +42,12 @@ export function validateSession</div>
    <div class="line line-ctx" id="line-0">
      <div class="line-num" id="line-0-num">42</div>
      <div id="line-0-text">  if (!token) return null;</div>
    </div>
    <div class="line line-del" id="line-1">
      <div class="line-num" id="line-1-num">43</div>
      <div id="line-1-text">-  const payload = jwt.decode(token);</div>
    </div>
    <div class="line line-add" id="line-2">
      <div class="line-num" id="line-2-num">43</div>
      <div id="line-2-text">+  const payload = await jwt.verify(token, secret);</div>
    </div>
    <div class="line line-add" id="line-3">
      <div class="line-num" id="line-3-num">44</div>
      <div id="line-3-text">+  if (!payload || payload.exp &lt; Date.now() / 1000) {</div>
    </div>
    <div class="line line-add" id="line-4">
      <div class="line-num" id="line-4-num">45</div>
      <div id="line-4-text">+    return null;</div>
    </div>
    <div class="line line-add" id="line-5">
      <div class="line-num" id="line-5-num">46</div>
      <div id="line-5-text">+  }</div>
    </div>
    <div class="line line-ctx" id="line-6">
      <div class="line-num" id="line-6-num">47</div>
      <div id="line-6-text">  return payload as SessionPayload;</div>
    </div>
  </div>
</Panel>